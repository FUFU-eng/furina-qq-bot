# 复制成 .env 再填。这里只列常用项，没列到的都有默认值，
# 大部分开关和数值在控制面板「设置」里改更方便，改完即时生效。

# ---- NoneBot / 连接 ----
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[]
COMMAND_START=["/", ""]
API_TIMEOUT=60
# 机器人自己的 QQ 号
BOT_QQ=
# 需要走代理的请求（Pixiv、搜图、JM 等），不需要就留空
PROXY_URL=

# ---- 群 ----
# 强化图转发：MAIN 群里强化完的图会同时发到 SUB 群，留空 = 不转发
MAIN_GROUP_ID=
SUB_GROUP_ID=
# 群主（也就是你）的 QQ：不限次数、能用管理指令
AI_CHAT_GROUP_OWNER_QQ=
# 特别关照的人：芙芙会格外偏爱的人，只认 QQ 号；不需要就留空
AI_CHAT_SPECIAL_QQ=
# 群里其他机器人的 QQ，可带备注，如 10001(小派蒙)
AI_CHAT_PEER_BOTS=

# ---- 聊天模型（OpenAI 兼容接口，默认按 DeepSeek 写的）----
AI_CHAT_LLM_API_KEY=
AI_CHAT_LLM_BASE_URL=https://api.deepseek.com
AI_CHAT_LLM_MODEL=deepseek-chat
# 可选：多个模型轮换/兜底，逗号分隔
AI_CHAT_LLM_MODELS=
# 同步群成员的群，逗号分隔；留空 = 用米游社推送的群
AI_CHAT_GROUPS=
# 没被艾特时随机接话的概率
AI_CHAT_PROBABILITY=0.02
AI_CHAT_HISTORY_LIMIT=
AI_CHAT_HISTORY_SEED=
AI_CHAT_MAX_TOKENS=
AI_CHAT_DAILY_CHAT_LIMIT=40
# 单独给某些人放宽次数，如 10001:100,10002:0
AI_CHAT_DAILY_LIMIT_OVERRIDES=
AI_CHAT_VISION=
AI_CHAT_IMAGE_DESC=false
AI_CHAT_IMAGE_DESC_MAX_PER_HOUR=
AI_CHAT_VISION_MAX_IMAGES=
AI_CHAT_STICKER_PROBABILITY=
AI_CHAT_STICKER_MAX_COUNT=
AI_CHAT_STICKER_TTL=
AI_CHAT_POKE_PROBABILITY=
AI_CHAT_POKE_REPLY=
AI_CHAT_POKE_COOLDOWN=
AI_CHAT_EMOTION_ENABLED=
AI_CHAT_EMOTION_START_MOOD=
AI_CHAT_DIGEST_ENABLED=
AI_CHAT_DIGEST_HOUR=
AI_CHAT_DIGEST_MINUTE=
AI_CHAT_DIGEST_MAX_LINES=
AI_CHAT_DIGEST_KEEP_DAYS=
# 可选：DeepSeek 网页端的登录令牌，只用来在面板里看每天花了多少钱。不填就只显示余额
DEEPSEEK_WEB_TOKEN=

# ---- 外部资源 ----
# 放 Real-ESRGAN、ffmpeg、搜图用的浏览器资料夹、站点 cookies 的目录，不进仓库
ASSETS_ROOT=
EDGE_USER_DATA_DIR=
PAGE_LOAD_TIMEOUT=
# NapCat 安装目录（面板里启动/停止 NapCat、看二维码和日志）
NAPCAT_DIR=
NAPCAT_WEBUI_URL=
NAPCAT_WEBUI_PORT=
NAPCAT_HTTP_PORT=

# ---- 搜图 ----
SEARCH_TIMEOUT=
SEARCH_STOP_VISIT_SECONDS=
SEARCH_YANDEX_BUDGET_SECONDS=
SEARCH_COOLDOWN=
YANDEX_FALLBACK=
YANDEX_MAX_PAGES=
VISION_SIM_THRESHOLD=
VISION_MAX_CANDIDATES=
# 可选：本地 Eagle 图库（先在本地库里找原图）
EAGLE_LIBRARY_DIR=

# ---- 米游社资讯 ----
MIYOUSHE_GROUPS=
MIYOUSHE_POLL_INTERVAL=
MIYOUSHE_FORUMS=
MIYOUSHE_BACKFILL=

# ---- 群主发图转发 ----
RELAY_ENABLED=false
RELAY_SOURCE_GROUP=
RELAY_TARGET_GROUP=
RELAY_OWNER_QQ=
RELAY_AUTO_USERS=

# ---- 封神榜 ----
FENGSHEN_ENABLED=
FENGSHEN_GROUPS=
FENGSHEN_WEEKDAYS=
FENGSHEN_HOUR=
FENGSHEN_MINUTE=
FENGSHEN_TOP_N=
MEMBER_SYNC_INTERVAL=

# ---- JM ----
JM_ENABLED=false
JM_CACHE_DIR=
JM_PROXY=
JM_TIMEOUT=
JM_MAX_IMAGES=
JM_DAILY_USER_LIMIT=
JM_DAILY_GROUP_LIMIT=
JM_PROGRESS_INTERVAL=

# ---- 图片筛选（收图 → 手机/网页上筛 → 丢进 Eagle 自动导入文件夹）----
PIC_INBOX_DIR=
PIC_INBOX_EXPORT_DIR=
# 外网访问地址（自己的 Cloudflare Tunnel 之类），留空 = 只在本机用
PIC_INBOX_PUBLIC_URL=

# ---- 语音（可选，需要自己准备 GPT-SoVITS 和模型）----
FURINA_TTS_ENABLED=false
FURINA_TTS_ENGINE_DIR=
FURINA_TTS_GPT=
FURINA_TTS_SOVITS=
FURINA_TTS_REF_WAV=
FURINA_TTS_REF_TEXT=
FURINA_TTS_PORT=9881
FURINA_TTS_EMOTIONS=
# 0 = 不因为空闲自动关；内存紧张时才会停
FURINA_TTS_IDLE_MINUTES=0

# ---- 聊天模式 ----
# 一代仿真（默认）/ 二代仿真 / 聊天 / Agent；面板「模式与内核」里改更方便
AI_CHAT_MODE=一代仿真
# 个别群单独指定模式，如 10001:二代仿真,10002:一代仿真
AI_CHAT_MODE_GROUPS=
# 二代仿真（DSH 内核）运行环境放在哪，面板里点「安装 / 修复运行时」会装到这里
AI_CHAT_DSH_RUNTIME_DIR=
# 群会话最长多少（千 token），超过就换新会话省钱；0 = 不限
AI_CHAT_DSH_CONTEXT_MAX_K=60
# 换新会话时带上最近几条聊天
AI_CHAT_DSH_RECAP_LINES=30
# 内核出问题时自动退回一代仿真
AI_CHAT_DSH_FALLBACK=true
# Agent（主人私聊派活，会在电脑上执行命令），默认关
AI_CHAT_AGENT_ENABLED=false
# 额外禁用的套路句式，逗号分隔，用「…」表示中间随便几个字，如 这…我服
AI_CHAT_BANNED_PATTERNS=
# 群发言限流总开关（每分钟 / 每小时上限，按群算）
AI_CHAT_SEND_LIMIT_ENABLED=true

# ---- 免费模型线路（可选：本机的 OpenAI 兼容服务，失败自动换回付费模型）----
AI_CHAT_FREE_ENABLED=false
AI_CHAT_FREE_BASE_URL=
AI_CHAT_FREE_API_KEY=
AI_CHAT_FREE_MODELS=

# ---- B 站直播（用你自己的号开播，见 README）----
BILI_LIVE_ENABLED=false
# 主人（你自己）的 B 站 UID
BILI_PARTNER_MID=
# 直播间号；留空 = 按上面的 UID 自动找
BILI_LIVE_ROOM=
# 舞台上的 AI 标识，别去掉
BILI_LIVE_LABEL=AI 虚拟主播 · 同人非官方
# 额外屏蔽词，逗号分隔
BILI_LIVE_BLOCK_WORDS=

# ---- QQ 端（NapCat 或 SnowLuma，二选一，见 README）----
# napcat（默认）/ snowluma
QQ_TRANSPORT=napcat
# 反向 WebSocket 的访问令牌；SnowLuma 模式必填，至少 32 位
ONEBOT_V11_ACCESS_TOKEN=
# SnowLuma 目录和它用的 node.exe（留空 = 默认位置）
SNOWLUMA_DIR=
SNOWLUMA_NODE=
SNOWLUMA_HTTP_URL=http://127.0.0.1:13000
# SnowLuma HTTP 接口的令牌，至少 32 位
SNOWLUMA_HTTP_TOKEN=
SNOWLUMA_WEBUI_HOST=127.0.0.1
SNOWLUMA_WEBUI_PORT=5099
# 面板里确认过 QQ 号后会自动变成 true；在那之前机器人不收不发
SNOWLUMA_ACCOUNT_CONFIRMED=false
# 让 SnowLuma 去服务器补拉历史消息（默认只用本地记录）
SNOWLUMA_HISTORY_SYNC=false

# ---- 花钱上限（元；留空 = 每天 3 元、每群不限，填 0 = 不限；超了只回叫到她的）----
AI_CHAT_DAILY_CAP_YUAN=
AI_CHAT_GROUP_DAILY_CAP_YUAN=

# ---- B 站画师图片（全群共用的 UP 名单，面板里管理）----
BILI_PICS_ENABLED=true
# 多久检查一次（分钟，5~1440）
BILI_PICS_INTERVAL_MINUTES=20
# 每次检查几个 UP
BILI_PICS_SCAN_BATCH=3

PYTHONIOENCODING=utf-8
PYTHONUTF8=1
